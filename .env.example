LOCAL_FALCON_API_KEY=
GOOGLE_MAPS_API_KEY=

# OAuth client secret used to authenticate this server to LocalFalcon's
# token/revocation endpoints. Server-side only — never returned to a client.
OAUTH_CLIENT_SECRET=

# This server's public origin, used verbatim as the OAuth issuer and to build
# the advertised authorize/token/register/revoke endpoints (RFC 8414) and the
# /oauth/callback redirect_uri.
#
# REQUIRED IN PRODUCTION. Without it, those URLs are derived from request
# headers, so a client can influence them by sending X-Forwarded-Host.
# No trailing slash.
#
# Production value: https://mcp.localfalcon.com
# Leave BLANK for local development — when unset, loopback hosts are reflected
# so http://127.0.0.1:<port> works; setting it here would make a local server
# advertise the production origin.
PUBLIC_BASE_URL=

# Optional. Additional hosts this server is legitimately reached on, for
# multi-domain deployments. Comma-separated bare hosts; subdomains are NOT
# implied. Loopback is always allowed. A request arriving on one of these hosts
# gets metadata for that host, so each also needs its /oauth/callback
# registered with LocalFalcon.
# e.g. ALLOWED_HOSTS=mcp.example.com,mcp-staging.example.com:8443
ALLOWED_HOSTS=

# Optional. Additional trusted redirect_uri domains for self-hosted MCP
# clients whose callback host is not in the built-in platform allowlist.
# Comma-separated bare domains; subdomains ARE included.
#
# This governs POST /register, GET /oauth/authorize and GET /oauth/callback
# alike: without it, a registration whose only callback is on an unlisted host
# is answered with 400 invalid_redirect_uri. Loopback never needs listing.
# It cannot bypass the scheme/fragment/userinfo rules — https only.
ADDITIONAL_TRUSTED_REDIRECT_DOMAINS=

# ── Memory / session budget ─────────────────────────────────────────────────
# Each live MCP session retains its own McpServer (~1.3 MB): the SDK requires a
# separate instance per transport, so resident session count is what drives heap
# use. These bound it. Defaults suit a large instance; lower them for a small one.

# Hard cap on concurrent sessions. At the cap, the least-recently-active session
# is evicted and its transport closed. An evicted client is not broken —
# presenting its old session ID triggers Bearer-token auto-recovery.
MAX_SESSIONS=2000

# Idle time before a session is swept, in ms (default 3600000 = 1 hour), and how
# often the sweep runs (default 300000 = 5 minutes). The check interval must be
# well under the timeout, or a dead session lingers for timeout + interval.
SESSION_INACTIVITY_TIMEOUT_MS=3600000
INACTIVITY_CHECK_INTERVAL_MS=300000

# Log full request/response bodies. Leave unset in production: scan responses are
# megabyte-class, pretty-printing roughly doubles them, and console output to a
# pipe queues on the heap with no bound under log backpressure.
DEBUG_PAYLOAD_LOGGING=

# NOTE: also set --max-old-space-size (see Dockerfile). V8's default ceiling is
# ~2 GB no matter how much RAM the container has, so without it a large instance
# OOMs early with most of its memory unused.
