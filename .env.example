LOCAL_FALCON_API_KEY=
GOOGLE_MAPS_API_KEY=

# OAuth client secret used to authenticate this server to LocalFalcon's
# token/revocation endpoints. Server-side only — never returned to a client.
OAUTH_CLIENT_SECRET=

# This server's public origin, used verbatim as the OAuth issuer and to build
# the advertised authorize/token/register/revoke endpoints (RFC 8414) and the
# /oauth/callback redirect_uri.
#
# REQUIRED IN PRODUCTION. Without it, those URLs are derived from request
# headers, so a client can influence them by sending X-Forwarded-Host.
# No trailing slash.
#
# Production value: https://mcp.localfalcon.com
# Leave BLANK for local development — when unset, loopback hosts are reflected
# so http://127.0.0.1:<port> works; setting it here would make a local server
# advertise the production origin.
PUBLIC_BASE_URL=

# Optional. Additional hosts this server is legitimately reached on, for
# multi-domain deployments. Comma-separated bare hosts; subdomains are NOT
# implied. Loopback is always allowed. A request arriving on one of these hosts
# gets metadata for that host, so each also needs its /oauth/callback
# registered with LocalFalcon.
# e.g. ALLOWED_HOSTS=mcp.example.com,mcp-staging.example.com:8443
ALLOWED_HOSTS=

# Optional. Additional trusted redirect_uri domains for self-hosted MCP
# clients whose callback host is not in the built-in platform allowlist.
# Comma-separated bare domains; subdomains ARE included.
ADDITIONAL_TRUSTED_REDIRECT_DOMAINS=
